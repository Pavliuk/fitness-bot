# Токен бота від @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Режим запуску — які роутери й фонові задачі вмикати:
#   fitness  — тренування/харчування/прогрес (стандартний фітнес-бот)
#   leadgen  — лише команди лідогенерації (/kw_add, /src_add, /leads тощо)
# Це ДВА РІЗНІ Telegram-боти (два різні BOT_TOKEN, два окремі деплої), що
# запускаються з одного коду — .env одного бота не повинен впливати на інший.
BOT_MODE=fitness

# Рядок підключення до БД
# Для старту (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./data/fitness.db
# Для переходу на PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fitness_bot

# Часовий пояс для нагадувань (IANA формат)
TIMEZONE=Europe/Kyiv

# Ключ Anthropic API (console.anthropic.com -> API Keys) — потрібен лише для
# розпізнавання БЖУ за фото страви в розділі «🍽 Харчування». Якщо залишити
# порожнім, ця одна кнопка не працюватиме, а решта бота — без змін.
ANTHROPIC_API_KEY=

# --- Нижче потрібно лише для деплою з BOT_MODE=leadgen ---
# Telegram ID адміністратора(-ів) бота через кому — тільки вони отримують доступ
# до команд лідогенерації (/kw_add, /src_add, /leads тощо) і до сповіщень про ліди.
# Дізнатись свій tg_id можна, написавши @userinfobot.
ADMIN_IDS=

# Дані для окремої Telegram user-сесії (my.telegram.org -> API development tools).
# Це НЕ токен бота: звичайний Bot API бот не може сам приєднуватись до публічних
# груп і читати їхню історію, тому моніторинг веде окремий акаунт-монітор.
# Залиште порожнім, якщо модуль лідогенерації поки не потрібен — бот запуститься
# і без нього, просто без пошуку лідів.
TG_API_ID=
TG_API_HASH=
# Шлях зберігається у data/ (те саме volume, що й БД), щоб сесія не губилась
# при перезапуску контейнера
TG_SESSION_NAME=data/leadgen_session

# Заповнюється тільки для деплою на хостинг (Railway тощо), де контейнер
# неінтерактивний і не може сам пройти Telethon-логін. Виконайте локально
# `python scripts/leadgen_login.py` — він виведе base64-рядок сесії, який
# треба вставити сюди цілком. Бот сам розпакує його у файл сесії при старті.
# Для локального запуску не потрібно — залиште порожнім.
TG_SESSION_B64=
